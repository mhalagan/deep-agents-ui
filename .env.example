# LangChain/LangGraph Configuration
NEXT_PUBLIC_DEPLOYMENT_URL="http://127.0.0.1:2024"
NEXT_PUBLIC_AGENT_ID=your_agent_id_from_langgraph_json
NEXT_PUBLIC_LANGSMITH_API_KEY=your_langsmith_api_key

# AWS Amplify Configuration (Optional - for advanced features)
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# AWS CLI Configuration (For local development with Amplify CLI)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Optional: For specific Amplify app management
AMPLIFY_APP_ID=your_amplify_app_id
AMPLIFY_BRANCH=main